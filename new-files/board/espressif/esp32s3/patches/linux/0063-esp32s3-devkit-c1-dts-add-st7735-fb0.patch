From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Antigravity <developer@deepmind.com>
Date: Tue, 3 Nov 2026 20:05:00 +0530
Subject: [PATCH] esp32s3-devkit-c1.dts: add ST7735 fb0 display and SD voltage-ranges

Add ST7735 128x160 TFT display node on SPI2 with CS on GPIO 9,
DC on GPIO 4, and RESET on GPIO 5, providing /dev/fb0.
Also add voltage-ranges to mmc_spi for microSD support.

Signed-off-by: Antigravity <developer@deepmind.com>
---
diff --git a/arch/xtensa/boot/dts/esp32s3-devkit-c1.dts b/arch/xtensa/boot/dts/esp32s3-devkit-c1.dts
index d83dd32..aa424fc 100644
--- a/arch/xtensa/boot/dts/esp32s3-devkit-c1.dts
+++ b/arch/xtensa/boot/dts/esp32s3-devkit-c1.dts
@@ -59,11 +59,26 @@
 &spi2 {
 	pinctrl-0 = <&spi2_pins>;
 	pinctrl-names = "default";
+	cs-gpios = <0>, <&gpio0 9 GPIO_ACTIVE_LOW>;
 	status = "ok";
 
 	mmc_spi@0 {
 		compatible = "mmc-spi-slot";
 		reg = <0>;
+		voltage-ranges = <2700 3600>;
+		spi-max-frequency = <20000000>;
+	};
+
+	display@1 {
+		compatible = "sitronix,st7735r";
+		reg = <1>;
+		spi-max-frequency = <20000000>;
+		dc-gpios = <&gpio0 4 GPIO_ACTIVE_HIGH>;
+		reset-gpios = <&gpio0 5 GPIO_ACTIVE_LOW>;
+		rotate = <0>;
+		buswidth = <8>;
+		fps = <30>;
+		bgr;
 	};
 };
 
